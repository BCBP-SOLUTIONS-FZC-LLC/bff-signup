# Version control
.git
.gitignore

# Environment files — never bake secrets into the image
.env
.env.*
*.env

# Development tooling and docs
.claude/
docs/lld/
docs/observability/
deploy/
scripts/
*.md
README.md
# docs/swagger/ is intentionally NOT excluded — router.go imports it at compile time

# Test artefacts
test/
coverage*.out
coverage*.html
*.coverprofile

# Build artefacts already compiled outside Docker
bin/

# IDE and OS noise
.idea/
.vscode/
*.DS_Store
*.swp
*.swo

# Go tool cache (not needed in image)
vendor/
