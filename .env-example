# App
APP_ENV=dev
APP_PORT=8080
METRICS_PORT=9090

# Valkey (local docker-compose — password matches docker-compose.yml requirepass)
VALKEY_URL=redis://:localdev@localhost:6379/0

# Secrets (populated by External Secrets in prod; set manually in dev)
SBFF_HMAC_KEY=dev-hmac-key-32-bytes-minimum!!!
SBFF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA  # Turnstile always-pass test key

# Upstream services (set to dev IAM or fakes)
REALM_PROVISIONER_BASE_URL=http://localhost:9001
ORG_MEMBERSHIP_BASE_URL=http://localhost:9002
CATALOG_BASE_URL=http://localhost:9003

# Phase 1.5 — leave empty until Billing service is built (PAID_SIGNUP_ENABLED=false disables /paid)
PAID_SIGNUP_ENABLED=false
BILLING_BASE_URL=
BILLING_TIMEOUT_MS=5000

# Captcha
CAPTCHA_SITE_KEY=1x00000000000000000000AA
CAPTCHA_EXPECTED_HOSTNAME=localhost
# CAPTCHA_SKIP=true — dev only; NEVER set in staging or prod (bypasses Turnstile entirely)
CAPTCHA_SKIP=false

# Public host
PUBLIC_HOST=signup.bcbpsolutions.com

# Password hashing
PBKDF2_ITERATIONS=210000

# Session
SESSION_TTL_SECONDS=1800

# Terms
TERMS_CURRENT_VERSION=2026-09

# Slug reserved list (comma-separated)
SLUG_RESERVED=admin,api,app,auth,billing,help,login,signup,status,support,trial,www,mail,static,cdn,internal,system,root,tenant,keycloak

# Timeouts (milliseconds)
RP_TIMEOUT_MS=900
I1_TIMEOUT_MS=300
ELIGIBILITY_TIMEOUT_MS=150
TURNSTILE_TIMEOUT_MS=300
REQUEST_DEADLINE_MS=2500

# Rate limits
RATE_SIGNUPS_PER_IP_PER_HOUR=3
RATE_ATTEMPTS_PER_EMAIL_PER_DAY=5
RATE_SESSIONS_PER_IP_PER_HOUR=20
RATE_POLLS_PER_SESSION_PER_MIN=60

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
