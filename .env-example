# App
APP_ENV=dev
APP_PORT=8080
METRICS_PORT=9090

# Valkey (local docker-compose — password matches docker-compose.yml requirepass)
VALKEY_URL=redis://:localdev@localhost:6379/0

# Secrets (populated by External Secrets in prod; set manually in dev)
SBFF_HMAC_KEY=dev-hmac-key-32-bytes-minimum!!!
SBFF_TURNSTILE_SECRET=1x0000000000000000000000000000000AA  # Turnstile always-pass test key

# Upstream services (set to dev IAM or fakes)
REALM_PROVISIONER_BASE_URL=http://localhost:9001
ORG_MEMBERSHIP_BASE_URL=http://localhost:9002
CATALOG_BASE_URL=http://localhost:9003

# Captcha
CAPTCHA_SITE_KEY=1x00000000000000000000AA
CAPTCHA_EXPECTED_HOSTNAME=localhost

# Public host
PUBLIC_HOST=signup.bcbpsolutions.com

# Password hashing
PBKDF2_ITERATIONS=210000

# OTel
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.observability.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
