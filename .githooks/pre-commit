#!/usr/bin/env bash
# Local commit gates: formatting and lint.
# Mirrors iam-authz-enrichment's .githooks/pre-commit. `make lint` uses the
# installed golangci-lint when it is v2, else CI's pinned version via `go run`.
set -euo pipefail

echo "[pre-commit] running tidy..."
make tidy

echo "[pre-commit] running fmt-check..."
make fmt-check

echo "[pre-commit] running lint..."
make lint
