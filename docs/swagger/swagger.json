{
    "swagger": "2.0",
    "info": {
        "description": "Public trial-signup BFF for the XpertPMS platform.\n\n**Unauthenticated.** All routes are public — no JWT or tenant identity at signup time.\nSession identity is established by SB-1 (cookie + CSRF token); every state-changing route requires both.\n\n**Flow.** SB-1 → SB-2 → (if 202) poll SB-3 → (if 409 slug_taken) SB-4.\n\n**Rate limits.** 3 signups per IP per hour; 5 attempts per email per 24 hours; 20 sessions per IP per hour; 60 status polls per session per minute.",
        "title": "Signup BFF API",
        "contact": {
            "name": "BCBP Solutions — Web / Growth",
            "email": "sharmila.dayalan@bcbpsolutions.com"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "0.1.0"
    },
    "host": "signup.bcbpsolutions.com",
    "basePath": "/api/v1/signup",
    "paths": {
        "/paid": {
            "post": {
                "security": [
                    {
                        "SessionCookie": []
                    },
                    {
                        "CSRFToken": []
                    }
                ],
                "description": "Authorises and charges the Stripe payment token, then provisions\na dedicated realm (RP-2) and tenant row (I-1) in one request.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signup"
                ],
                "summary": "Submit direct paid signup (SB-5)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "CSRF token from SB-1",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Paid signup payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.PaidSignupRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Signup fully provisioned",
                        "schema": {
                            "$ref": "#/definitions/http.PaidSignupResponse"
                        }
                    },
                    "202": {
                        "description": "Tenant still provisioning (status=provisioning, poll SB-3), or 3-D Secure needed (status=payment_action_required: complete action.client_secret, then re-POST the same body with a fresh captcha_token)",
                        "schema": {
                            "$ref": "#/definitions/http.PaidSignupResponse"
                        }
                    },
                    "400": {
                        "description": "Validation failed",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "401": {
                        "description": "Session expired or missing",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "403": {
                        "description": "CSRF token invalid or CAPTCHA failed",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "409": {
                        "description": "SLUG_TAKEN (+ suggestions): resubmit SB-5 with a new slug if paid but not yet provisioned, else SB-4; INVALID_STATE: a payment is in progress, or details changed after payment",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "410": {
                        "description": "CHARGE_EXPIRED — 3-D Secure not completed in time; start a new signup",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "422": {
                        "description": "PAYMENT_DECLINED (+ decline_reason, top-level); use another payment method",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "503": {
                        "description": "Dependency unavailable; retry the same body after Retry-After",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    }
                }
            }
        },
        "/session": {
            "get": {
                "description": "Creates an `sbff_sid` session cookie (30-min sliding TTL) and returns a CSRF token.\nRate-limited to 20 session starts per IP per hour.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "session"
                ],
                "summary": "Start signup session (SB-1)",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.SessionResponse"
                        }
                    },
                    "429": {
                        "description": "Too many session starts from this IP (Retry-After header, seconds)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "503": {
                        "description": "Valkey unavailable (fail-closed)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    }
                }
            }
        },
        "/trial": {
            "post": {
                "security": [
                    {
                        "SessionCookie": []
                    },
                    {
                        "CSRFToken": []
                    }
                ],
                "description": "Runs the provisioning handoff. Returns 201 when fully provisioned, 202 when I-1 is still\nin progress (poll SB-3), or 409 when the slug is already taken (submit SB-4 with a new slug).\nRequires the session cookie and X-CSRF-Token header from SB-1.\nRate-limited: 3 signups per IP per hour; 5 attempts per email per 24 hours.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signup"
                ],
                "summary": "Submit trial signup form (SB-2)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "CSRF token from SB-1",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Signup form payload",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.TrialSignupRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Signup fully provisioned",
                        "schema": {
                            "$ref": "#/definitions/http.TrialSignupResponse"
                        }
                    },
                    "202": {
                        "description": "Keycloak user created; tenant still provisioning — poll SB-3",
                        "schema": {
                            "$ref": "#/definitions/http.TrialSignupResponse"
                        }
                    },
                    "400": {
                        "description": "Validation failed (includes wrong Content-Type, unknown JSON fields)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "401": {
                        "description": "Session expired or missing",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "403": {
                        "description": "CSRF token invalid or CAPTCHA failed",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "409": {
                        "description": "Slug already taken — submit SB-4 with a new slug; or INVALID_STATE (same signup already being processed) with retry_after_ms — retry",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "413": {
                        "description": "Request body larger than 16 KiB",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "429": {
                        "description": "Rate limit exceeded (Retry-After header, seconds)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "503": {
                        "description": "Dependency unavailable (Valkey, Turnstile, RP-1)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    }
                }
            }
        },
        "/{signup_id}/slug": {
            "post": {
                "security": [
                    {
                        "SessionCookie": []
                    },
                    {
                        "CSRFToken": []
                    }
                ],
                "description": "Retries I-1 tenant creation with a new slug. The Keycloak user from RP-1 is reused.\nRequires the handoff to be in slug_conflict state (signalled by SB-2 or SB-3 returning 409 slug_taken).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signup"
                ],
                "summary": "Change slug after conflict (SB-4)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "CSRF token from SB-1",
                        "name": "X-CSRF-Token",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Signup ID from SB-1",
                        "name": "signup_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "New slug",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.SlugChangeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Signup fully provisioned with new slug",
                        "schema": {
                            "$ref": "#/definitions/http.TrialSignupResponse"
                        }
                    },
                    "202": {
                        "description": "I-1 still in progress — poll SB-3",
                        "schema": {
                            "$ref": "#/definitions/http.TrialSignupResponse"
                        }
                    },
                    "400": {
                        "description": "Slug validation failed",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "401": {
                        "description": "Session expired or missing",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "403": {
                        "description": "CSRF token invalid",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "404": {
                        "description": "Signup not found or does not belong to this session",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "409": {
                        "description": "New slug also taken — try again",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    }
                }
            }
        },
        "/{signup_id}/status": {
            "get": {
                "security": [
                    {
                        "SessionCookie": []
                    }
                ],
                "description": "Returns the current handoff state. Poll every `poll_after_ms` milliseconds after a 202 from SB-2.\nWhen status is \"action_required\" with action \"choose_slug\", submit SB-4 with a new slug.\nAfter 15 minutes in \"provisioning\", status becomes \"failed\".",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "signup"
                ],
                "summary": "Poll provisioning status (SB-3)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Signup ID returned by SB-1",
                        "name": "signup_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.StatusResponse"
                        }
                    },
                    "401": {
                        "description": "Session expired or missing",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "404": {
                        "description": "Signup not found or does not belong to this session",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    },
                    "429": {
                        "description": "Too many status polls (Retry-After header, seconds)",
                        "schema": {
                            "$ref": "#/definitions/http.ProblemResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.PasswordPolicy": {
            "type": "object",
            "properties": {
                "max_length": {
                    "type": "integer"
                },
                "min_length": {
                    "type": "integer"
                },
                "not_email": {
                    "type": "boolean"
                },
                "require_classes": {
                    "type": "integer"
                }
            }
        },
        "domain.Plan": {
            "type": "string",
            "enum": [
                "starter",
                "pro",
                "enterprise"
            ],
            "x-enum-varnames": [
                "PlanStarter",
                "PlanPro",
                "PlanEnterprise"
            ]
        },
        "domain.PlanInfo": {
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "#/definitions/domain.Plan"
                },
                "name": {
                    "type": "string"
                },
                "trial_days": {
                    "type": "integer"
                }
            }
        },
        "domain.SlugRules": {
            "type": "object",
            "properties": {
                "max": {
                    "type": "integer"
                },
                "min": {
                    "type": "integer"
                },
                "pattern": {
                    "type": "string"
                }
            }
        },
        "github_com_BCBP-SOLUTIONS-FZC-LLC_platform-gincommon_v2_internal_problem.FieldError": {
            "type": "object",
            "properties": {
                "field": {
                    "description": "Field is the JSON path of the invalid field (e.g. \"deadline\", \"items[0].sku\").",
                    "type": "string"
                },
                "message": {
                    "description": "Message is a fixed phrase (\"is required\", \"must be in the future\"). It never\nechoes the rejected value, which may be PII.",
                    "type": "string"
                }
            }
        },
        "http.CaptchaInfo": {
            "type": "object",
            "properties": {
                "provider": {
                    "type": "string"
                },
                "site_key": {
                    "type": "string"
                }
            }
        },
        "http.PaidSignupRequest": {
            "type": "object",
            "required": [
                "admin_email",
                "admin_name",
                "captcha_token",
                "company_name",
                "password",
                "payment_token",
                "plan",
                "seats",
                "terms_version"
            ],
            "properties": {
                "accept_terms": {
                    "type": "boolean"
                },
                "admin_email": {
                    "type": "string"
                },
                "admin_name": {
                    "type": "string"
                },
                "captcha_token": {
                    "type": "string"
                },
                "company_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "payment_token": {
                    "description": "Stripe token from browser",
                    "type": "string"
                },
                "plan": {
                    "$ref": "#/definitions/domain.Plan"
                },
                "seats": {
                    "type": "integer",
                    "maximum": 1000,
                    "minimum": 1
                },
                "slug": {
                    "type": "string"
                },
                "terms_version": {
                    "type": "string"
                }
            }
        },
        "http.PaidSignupResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "description": "status=payment_action_required only",
                    "allOf": [
                        {
                            "$ref": "#/definitions/http.PaymentAction"
                        }
                    ]
                },
                "email_verification_sent": {
                    "type": "boolean"
                },
                "expires_at": {
                    "description": "status=payment_action_required only",
                    "type": "string"
                },
                "next": {
                    "type": "string"
                },
                "poll_after_ms": {
                    "type": "integer"
                },
                "signup_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "http.PaymentAction": {
            "type": "object",
            "properties": {
                "client_secret": {
                    "type": "string"
                },
                "type": {
                    "description": "\"3ds\"",
                    "type": "string"
                }
            }
        },
        "http.ProblemResponse": {
            "type": "object",
            "properties": {
                "detail": {
                    "description": "Detail is a sentence the service wrote about this occurrence. It never\ncarries exception text, SQL, secrets or tenant information.",
                    "type": "string"
                },
                "errorCode": {
                    "description": "ErrorCode is the stable, upper snake case, machine-readable code.",
                    "type": "string"
                },
                "instance": {
                    "description": "Instance is the request path (never the query string, which may carry tokens).",
                    "type": "string"
                },
                "status": {
                    "description": "Status is the HTTP status code; it always equals the response status.",
                    "type": "integer"
                },
                "tenantId": {
                    "description": "TenantID is set only for a request with a verified tenant context.",
                    "type": "string"
                },
                "timestamp": {
                    "description": "Timestamp is when the problem was created, formatted with TimestampLayout.",
                    "type": "string"
                },
                "title": {
                    "description": "Title is the short, fixed summary of the type. It never varies per occurrence.",
                    "type": "string"
                },
                "traceId": {
                    "description": "TraceID correlates the response with the server's logs and traces.",
                    "type": "string"
                },
                "type": {
                    "description": "Type is the absolute, stable type URI ({base}/{domain}/{error}), or\n\"about:blank\" for a status without a registered type (RFC 9457 §4.2.1).",
                    "type": "string"
                },
                "validationErrors": {
                    "description": "ValidationErrors lists the invalid fields of a validation-failed problem.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/github_com_BCBP-SOLUTIONS-FZC-LLC_platform-gincommon_v2_internal_problem.FieldError"
                    }
                }
            }
        },
        "http.SessionResponse": {
            "type": "object",
            "properties": {
                "captcha": {
                    "$ref": "#/definitions/http.CaptchaInfo"
                },
                "csrf_token": {
                    "type": "string"
                },
                "current_terms_version": {
                    "description": "browser must echo this back in SB-2",
                    "type": "string"
                },
                "password_policy": {
                    "$ref": "#/definitions/domain.PasswordPolicy"
                },
                "plans": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.PlanInfo"
                    }
                },
                "signup_id": {
                    "type": "string"
                },
                "slug_rules": {
                    "$ref": "#/definitions/domain.SlugRules"
                }
            }
        },
        "http.SlugChangeRequest": {
            "type": "object",
            "required": [
                "slug"
            ],
            "properties": {
                "slug": {
                    "type": "string"
                }
            }
        },
        "http.StatusResponse": {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "poll_after_ms": {
                    "type": "integer"
                },
                "signup_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "http.TrialSignupRequest": {
            "type": "object",
            "required": [
                "admin_email",
                "admin_name",
                "captcha_token",
                "company_name",
                "password",
                "plan",
                "terms_version"
            ],
            "properties": {
                "accept_terms": {
                    "type": "boolean"
                },
                "admin_email": {
                    "type": "string"
                },
                "admin_name": {
                    "type": "string"
                },
                "captcha_token": {
                    "type": "string"
                },
                "company_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "plan": {
                    "$ref": "#/definitions/domain.Plan"
                },
                "slug": {
                    "type": "string"
                },
                "terms_version": {
                    "type": "string"
                }
            }
        },
        "http.TrialSignupResponse": {
            "type": "object",
            "properties": {
                "email_verification_sent": {
                    "type": "boolean"
                },
                "next": {
                    "type": "string"
                },
                "poll_after_ms": {
                    "type": "integer"
                },
                "signup_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "CSRFToken": {
            "description": "CSRF token returned by SB-1 (GET /session). Required on all state-changing routes (POST). Must match the hash stored in the session cookie.",
            "type": "apiKey",
            "name": "X-CSRF-Token",
            "in": "header"
        },
        "SessionCookie": {
            "description": "Session cookie set by SB-1 (GET /session). HttpOnly; Secure; SameSite=Strict; 30-minute sliding TTL.",
            "type": "apiKey",
            "name": "sbff_sid",
            "in": "cookie"
        }
    }
}